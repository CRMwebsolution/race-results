# Supabase Configuration
# Public connection parameters exposed to browser client
NEXT_PUBLIC_SUPABASE_URL=https://kzugyadzbqnurwbkmrik.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only administrative key (NEVER expose to browser client or commit secrets)
SUPABASE_SERVICE_ROLE_KEY=
# Application URL
NEXT_PUBLIC_SITE_URL=

# Stripe Billing Configuration
# Get these from your Stripe Dashboard (Developers -> API keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# (Optional) Override the hardcoded Stripe Price IDs for your specific Stripe Products
# Note: Ensure the amounts in src/lib/billing/catalog.ts match your Stripe prices exactly
# STRIPE_PRICE_EVENT_PASS=
# STRIPE_PRICE_STANDARD=
# STRIPE_PRICE_PREMIUM=

# SMTP Configuration
# Configure these in Supabase Dashboard -> Project Settings -> Auth -> SMTP
# You do NOT need to set these in this .env file unless you have a custom mailer setup,
# but here is the reference format for Supabase SMTP configuration:
# SMTP_HOST=smtp.mailgun.org (or SendGrid, Resend, etc)
# SMTP_PORT=465 (or 587)
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_SENDER_NAME="RaceHoller Support"
# SMTP_SENDER_EMAIL=support@raceholler.com
